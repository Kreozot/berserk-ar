{
  "name": "berserk-ar",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "check": "biome check src index.ts vitest.config.ts",
    "check:fix": "biome check --write src index.ts vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "expo": "~57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "1.0.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-resizer": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
